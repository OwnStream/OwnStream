@using OwnStream.Database.Models
@model OwnStream.Database.Models.DatabaseContent

@{
	string title = Model.TranslatedTitle.GetLocalized(Model.Title, Context);
	string tagline = Model.TranslatedTagline.GetLocalized(Model.Tagline, Context);
	string description = Model.TranslatedDescription.GetLocalized(Model.Description, Context);
	ViewBag.Title = title;
	Layout = "_Layout";
}

<table>
	<tbody>
	<tr>
		<td>
			<img src="@Model.Poster" alt="@title" style="width: 200px; height: 300px; margin-right: 8px	">
		</td>
		<td style="vertical-align: top">
			@if (Model.Type == DatabaseContent.ContentType.Movie)
			{
				<h2>@title - @Model.ReleasedAt.Year</h2>
			}
			else
			{
				<h2>@title - @Model.ReleasedAt.Year — @Model.FinishedStreamingAt?.Year</h2>
			}
			<div>@tagline</div>
			<hr/>
			<p>@description</p>
		</td>
	</tr>
	</tbody>
</table>
<hr/>
@if (Model.Type == DatabaseContent.ContentType.Movie)
{
	Guid? videoId = Model.Episodes.FirstOrDefault()?.Videos?.FirstOrDefault()?.Id;

	if (videoId != null)
	{
		<a class="btn btn-primary" asp-controller="Video" asp-action="Watch" asp-route-id="@videoId">Watch</a>
	}
	else
	{
		<div class="btn btn-secondary">Video not found</div>
	}
}
<hr/>
<h3>Episodes</h3>
<table class="table table-hover">
	<thead>
	<tr>
		<td>#</td>
		<td>Thumbnail</td>
		<td>Title</td>
		<td>Description</td>
		<td>Actions</td>
	</tr>
	</thead>
	<tbody>
	@foreach (DatabaseEpisode episode in Model.Episodes.OrderByDescending(x => x.Season).ThenBy(x => x.Episode))
	{
		<tr>
			<td>@(episode.Season)x@(episode.Episode)</td>
			<td style="width: 170px"><img height="96" width="170" style="background: #333; display: block"
			                              src="@episode.Thumbnail" alt="Thumbnail"></td>
			<td>@episode.TranslatedTitle.GetLocalized(episode.Title, Context)</td>
			<td>@episode.TranslatedSummary.GetLocalized(episode.Summary, Context)</td>
			<td>
				@if (episode.Videos.Count > 0)
				{
					<a class="btn btn-primary" asp-controller="Video" asp-action="Watch"
					   asp-route-id="@episode.Videos.First().Id">Watch</a>
				}
			</td>
		</tr>
	}
	</tbody>
</table>