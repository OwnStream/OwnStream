@using OwnStream.Database.Models
@model OwnStream.Database.Models.DatabaseContent

@{
	string title = Model.TranslatedTitle.GetLocalized(Model.Title, Context)!;
	string tagline = Model.TranslatedTagline.GetLocalized(Model.Tagline, Context)!;
	string description = Model.TranslatedDescription.GetLocalized(Model.Description, Context)!;
	ViewBag.Title = title;
	Layout = "_Layout";
}

<table>
	<tbody>
	<tr>
		<td>
			<img src="@Model.Poster" alt="@title" style="width: 200px; height: 300px; margin-right: 8px	">
		</td>
		<td style="vertical-align: top">
			@if (Model.Type == DatabaseContent.ContentType.Movie)
			{
				<h2>@title - @Model.ReleasedAt.Year</h2>
			}
			else
			{
				<h2>@title - @Model.ReleasedAt.Year — @Model.FinishedStreamingAt?.Year</h2>
			}
			<div>@tagline</div>
			<hr/>
			<p>@description</p>
		</td>
	</tr>
	</tbody>
</table>
<hr/>
<a class="btn btn-secondary" id="watchButton">Loading episode to watch...</a>
<a class="btn btn-secondary" asp-controller="Job" asp-action="Index" asp-route-relevantContent="@Model.Id">Relevant
	Jobs</a>
<script>
	const button = document.getElementById("watchButton")
	fetch("/api/progress/upNext/@Model.Id")
		.then(x => x.json())
		.then(data => {
			const episode = data.continueWatching || data.upNext;
			const video = episode.videos[0];
			if (episode && video) {
				button.classList.replace("btn-secondary", "btn-primary");
				button.removeAttribute("disabled");

				button.href = `/Video/Watch/${video.id}`
				button.innerText = `Watch S: ${episode.seasonNumber}  E: ${episode.episodeNumber} - ${episode.translatedTitle || episode.originalTitle}`
			} else {
				button.innerText = `No videos found.`
			}
		});
</script>
<hr/>
<h3>Episodes</h3>
<ul class="nav nav-tabs">
	@{ Dictionary<int, DatabaseEpisode[]> groupedEpisodes = Model.Episodes.GroupBy(x => x.Season).ToDictionary(x => x.Key, x => x.ToArray()); }
	@foreach (int season in groupedEpisodes.Keys.Order())
	{
		<li class="nav-item">
			<a class="nav-link @(season == groupedEpisodes.Keys.First() ? "active" : "")" href="#"
			   data-episode-tab="@season" onclick="toggleTab(@season)">Season @season</a>
		</li>
	}
</ul>
@foreach ((int season, DatabaseEpisode[] episodes) in groupedEpisodes.OrderBy(x => x.Key))
{
	<div data-episode-tab-block="@season" style="display: @(season == groupedEpisodes.First().Key ? "block" : "none")">
		<table class="table table-hover">
			<thead>
			<tr>
				<td>#</td>
				<td>Thumbnail</td>
				<td>Title</td>
				<td>Actions</td>
			</tr>
			</thead>
			<tbody>
			@foreach (DatabaseEpisode episode in episodes.OrderBy(x => x.Episode))
			{
				<tr data-episode-id="@episode.Id">
					<td style="width: 80px; text-align: center; vertical-align: middle">@(episode.Season)x@(episode.Episode)</td>
					<td style="width: 170px">
						<img height="96" width="170" style="background: #333; display: block"
						     src="@episode.Thumbnail" alt="Thumbnail"></td>
					<td><b>@episode.TranslatedTitle.GetLocalized(episode.Title, Context)</b><br/>
						@episode.TranslatedSummary.GetLocalized(episode.Summary, Context)</td>
					<td>
						@if (episode.Videos.Count > 0)
						{
							<a class="btn btn-primary" asp-controller="Video" asp-action="Watch"
							   asp-route-id="@episode.Videos.First().Id">Watch</a>
						}
						<a class="btn btn-secondary" asp-controller="Job" asp-action="Index"
						   asp-route-relevantEpisode="@episode.Id">Relevant Jobs</a>
					</td>
				</tr>
			}
			</tbody>
		</table>
	</div>
}
<script>
	function toggleTab(index) {
		document.querySelectorAll("[data-episode-tab-block]").forEach(tab => {
			const thisIndex = tab.getAttribute("data-episode-tab-block");
			tab.style.display = thisIndex == index ? "block" : "none";
		})

		document.querySelectorAll("[data-episode-tab]").forEach(tab => {
			const thisIndex = tab.getAttribute("data-episode-tab");
			console.log(thisIndex, index, thisIndex == index)
			if (thisIndex == index) {
				tab.classList.add("active");
			} else {
				tab.classList.remove("active");
			}
		})
	}
</script>