@using Humanizer
@using OwnStream.Database.Models
@{
	ViewBag.Title = "Create Library";
	Layout = "_Layout";
}

<h2>Create Library</h2>
<form method="post">
	<div class="mb-3">
		<label for="name" class="form-label">Name</label>
		<input type="text" class="form-control" id="name" name="name" placeholder="Movies, Shows, Everything else">
	</div>
	<div class="mb-3">
		<label for="path" class="form-label">Path</label>
		<input type="text" class="form-control" id="path" name="path" placeholder="/media/whatever">
	</div>
	<input type="submit" class="btn btn-primary" value="Create library"/>
</form>

