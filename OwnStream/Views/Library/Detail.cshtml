@using Humanizer
@using OwnStream.Database.Models
@model OwnStream.Database.Models.DatabaseLibrary

@{
	ViewBag.Title = Model.Name;
	Layout = "_Layout";
	DiskInfo spaceInfo = Model.GetSpaceInfo();
	float percent = ((float)spaceInfo.Used / spaceInfo.Total) * 100;
}

<h2>@Model.Name</h2>

<p>
	<b>Path:</b> <code>@Model.Path</code><br/>
	<b>Space</b>: @spaceInfo.Used.Bytes() / @spaceInfo.Total.Bytes() (@spaceInfo.Available.Bytes() free)<br/>
</p>
<div class="progress" role="progressbar" aria-label="Disk usage" aria-valuenow="@spaceInfo.Used.Bytes()" aria-valuemin="0"
     aria-valuemax="@spaceInfo.Total.Bytes()">
	<div class="progress-bar" style="width: @percent%">@percent.ToString("F2")%</div>
</div>
