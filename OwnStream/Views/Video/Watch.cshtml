@model OwnStream.Database.Models.DatabaseVideo

@{
	ViewBag.Title = "Watch";
	Layout = "_Layout";
}

<h2>Watch</h2>
<link href="~/lib/ltplayer/ltplayer.min.css" rel="stylesheet">
<script src="~/lib/ltplayer/ltplayer.js"></script>
<script src="https://cdn.jsdelivr.net/npm/hls.js@1"></script>
<style>
	.ltp-controls-button > svg,
	.ltp-controls-volume-icon > svg {
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
		fill: none;
	}

	.ltp-root {
		min-height: 500px;
	}

	.libassjs-canvas-parent, video {
		position: absolute !important;
		left: 0 !important;
		right: 0 !important;
		width: 100%;
		height: 100%;
	}

	.libassjs-canvas-parent, .libassjs-canvas-parent > canvas {
		pointer-events: none;
	}
</style>
<video>
	<p class="vjs-no-js">
		To view this video please enable JavaScript, and consider upgrading to a
		web browser that
		<a href="https://videojs.com/html5-video-support/" target="_blank">
			supports HTML5 video
		</a>
	</p>
</video>

@if (Context.Request.Query.ContainsKey("useAss"))
{
	<script src="~/lib/subtitlesoctopus/subtitles-octopus.js"></script>
	<script>
		function setSubs(subs) {
			if (subs.length === 0) return;
			return () => {
				window.SubtitlesOctopusOnLoad = function () {
					const sub = subs[0];
					const options = {
						video: window.player.player,
						subUrl: `/Media/@Model.Id/captions/${sub.files.ass}`,
						//fonts: ['/JavascriptSubtitlesOctopus/fonts/Arial.ttf', '/JavascriptSubtitlesOctopus/fonts/TimesNewRoman.ttf'],
						//onReady: onReadyFunction,
						//debug: true,
						workerUrl: '/lib/subtitlesoctopus/subtitles-octopus-worker.js',
						fallbackFont: '/lib/subtitlesoctopus/default.woff2'
					};
					window.octopusInstance = new SubtitlesOctopus(options); // You can experiment in console
				};
				if (SubtitlesOctopus) {
					SubtitlesOctopusOnLoad();
				}
			};
		}
	</script>
}
else
{
	<script>
		function setSubs(subs) {
			subs.forEach(sub => {
				if (sub.files.vtt === undefined) return;
				const track = document.createElement("track");
				track.setAttribute("src", `/Media/@Model.Id/captions/${sub.files.vtt}`);
				track.setAttribute("label", sub.title);
				track.setAttribute("srclang", sub.language);
				track.setAttribute("kind", "subtitles");
				document.querySelector("video").appendChild(track);
			});
		}
	</script>
}
<script>
	async function loadVideo() {
		const subtitlesResp = await fetch("/Media/@Model.Id/subtitles.json");
		let subs = [];
		if (subtitlesResp.ok) {
			const subtitles = await subtitlesResp.json();
			subs.push(...subtitles);
		}
		const callback = setSubs(subs);
		window.player = new Player("video", {
			author: {
				icon: "URL of the author icon",
				title: "Name of the video author",
				href: "Link to the author's website"
			},
			title: "Title of the video",
			buttons: {
				play: '<svg><use href="/lib/feather-icons/feather-sprite.svg#play"/></svg>',
				pause: '<svg><use href="/lib/feather-icons/feather-sprite.svg#pause"/></svg>',
				volumeMute: '<svg><use href="/lib/feather-icons/feather-sprite.svg#volume-x"/></svg>',
				volumeLow: '<svg><use href="/lib/feather-icons/feather-sprite.svg#volume"/></svg>',
				volumeMedium: '<svg><use href="/lib/feather-icons/feather-sprite.svg#volume-1"/></svg>',
				volumeHigh: '<svg><use href="/lib/feather-icons/feather-sprite.svg#volume-2"/></svg>',
				settings: '<svg><use href="/lib/feather-icons/feather-sprite.svg#settings"/></svg>',
				fullscreen: '<svg><use href="/lib/feather-icons/feather-sprite.svg#maximize"/></svg>',
				minimize: '<svg><use href="/lib/feather-icons/feather-sprite.svg#minimize"/></svg>'
			},
			storyboard: {
				type: 'yt_l1',
				src: "/Media/@Model.Id/trickplay/small.png"
			},
			hlsManifest: "/Media/@Model.Id/master.m3u8"
		}, "hls.js");
		window.player = player;
		if (callback) callback();
	}

	loadVideo();
</script>

<script>
	const video = document.querySelector("video");
	setInterval(() => {
		const played = Math.round(video.currentTime * 1000);
		const total = Math.round(video.duration * 1000);
		const finished = (played / total) > .95;
		fetch("/api/progress/update", {
			method: "POST",
			headers: {
				"Content-Type": "application/json"
			},
			body: JSON.stringify({
				videoId: "@Model.Id",
				videoLength: total,
				watchedMilliseconds: played,
				markAsWatched: finished
			})
		});
	}, 5000);
</script>