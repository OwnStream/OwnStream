@using OwnStream.Database.Models
@model OwnStream.Database.Models.DatabaseVideo[]

@{
	ViewBag.Title = "Videos";
	Layout = "_Layout";
}

<h2>Videos</h2>
<p>Showing only videos that aren't assigned to any movies/episodes.</p>
<ul>
	@foreach (DatabaseVideo video in Model)
	{
		<li>
			<a asp-action="Watch" asp-route-id="@video.Id">@video.Id</a>
		</li>
	}
</ul>