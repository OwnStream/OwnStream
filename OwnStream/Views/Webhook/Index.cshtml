@using OwnStream.Database.Models
@model OwnStream.Database.Models.DatabaseWebhook[]

@{
	ViewBag.Title = "Webhooks";
	Layout = "_Layout";
}

<h2>Webhooks</h2>
<a href="/Webhook/Create" class="btn btn-primary">Create new webhook</a>

<ul>
	@foreach (DatabaseWebhook webhook in Model)
	{
		<li><a href="/Webhook/Detail/@webhook.Id">@webhook.Name</a></li>
	}
</ul>