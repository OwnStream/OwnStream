@using OwnStream.Database.Models
@model OwnStream.Database.Models.DatabaseUser[]

@{
	ViewBag.Title = "Users";
	Layout = "_Layout";
}

<h2>Users</h2>
<a asp-action="Add" class="btn btn-primary">New user</a>

<table class="table table-hover">
	<thead>
	<tr>
		<td>ID</td>
		<td>Username</td>
		<td>Permissions</td>
		<td>Actions</td>
	</tr>
	</thead>
	<tbody>
	@foreach (DatabaseUser user in Model)
	{
		<tr>
			<td><code>@user.Id.ToString()</code></td>
			<td>@user.Username</td>
			<td>@user.Permissions</td>
			<td>
				<a asp-action="Detail" asp-route-id="@user.Id" class="btn btn-primary">Details</a>
			</td>
		</tr>
	}
	</tbody>
</table>