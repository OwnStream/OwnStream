@model OwnStream.Database.Models.DatabaseUser

@{
	ViewBag.Title = Model.Username;
	Layout = "_Layout";
}

<h2>@Model.Username</h2>
<p>
	<b>ID: </b> <code>@Model.Id</code><br/>
	<b>Permissions: </b> @Model.Permissions
</p>
<hr/>
<a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
<hr/>